          {
            "name": "status",
            "size": 3
          },
          {
            "name": "leadType",
            "size": 3
          },
          {
            "name": "routeKey",
            "size": 3
          },
          {
            "name": "sigmaIncomingId",
            "size": 3
          }
        ],
        [
          {
            "name": "name",
            "size": 4
          },
          {
            "name": "phone",
            "size": 4
          },
          {
            "name": "email",
            "size": 4
          }
        ],
        [
          {
            "name": "courseSlug",
            "size": 4
          },
          {
            "name": "courseTitle",
            "size": 4
          },
          {
            "name": "formId",
            "size": 4
          }
        ],
        [
          {
            "name": "pageUrl",
            "size": 12
          }
        ],
        [
          {
            "name": "utmSource",
            "size": 3
          },
          {
            "name": "utmMedium",
            "size": 3
          },
          {
            "name": "utmCampaign",
            "size": 3
          },
          {
            "name": "utmContent",
            "size": 3
          }
        ],
        [
          {
            "name": "utmTerm",
            "size": 4
          },
          {
            "name": "idempotencyKey",
            "size": 8
          }
        ],
        [
          {
            "name": "lastError",
            "size": 12
          }
        ],
        [
          {
            "name": "sigmaRequest",
            "size": 6
          },
          {
            "name": "sigmaResponse",
            "size": 6
          }
        ],
        [
          {
            "name": "rawPayload",
            "size": 12
          }
        ]
      ]
    }
  },
  "attributes": {
    "source": {
      "type": "string",
      "default": "tilda"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "received",
        "sent",
        "failed",
        "duplicate"
      ],
      "default": "received",
      "required": true
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "email": {
