{
  "kind": "collectionType",
  "collectionName": "tilda_leads",
  "info": {
    "singularName": "tilda-lead",
    "pluralName": "tilda-leads",
    "displayName": "Tilda лид",
    "description": "Заявка, принятая из HTML-формы Tilda и переданная в SIGMA Messaging"
  },
  "options": {
    "draftAndPublish": false
  },
  "config": {
    "layouts": {
      "list": [
        "id",
        "status",
        "name",
        "phone",
        "courseSlug",
        "leadType",
        "sigmaIncomingId",
        "createdAt"
      ],
      "edit": [
