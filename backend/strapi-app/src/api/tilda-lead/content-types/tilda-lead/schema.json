    },
    "courseSlug": {
      "type": "string"
    },
    "courseTitle": {
      "type": "string"
    },
    "formId": {
      "type": "string"
    },
    "pageUrl": {
      "type": "string"
    },
    "utmSource": {
      "type": "string"
    },
    "utmMedium": {
      "type": "string"
    },
    "utmCampaign": {
      "type": "string"
    },
    "utmContent": {
      "type": "string"
    },
    "utmTerm": {
      "type": "string"
    },
    "leadType": {
      "type": "string"
    },
    "routeKey": {
      "type": "string"
    },
    "sigmaDestination": {
      "type": "string"
    },
    "sigmaIncomingId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
